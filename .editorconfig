# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
charset = utf-8
indent_size = 4
indent_style = space
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL

[*.{xml,html}]
indent_size = 2
indent_style = space

[*.{yml,yaml}]
indent_size = 2
indent_style = space

[*.gradle.kts]
indent_size = 4
indent_style = space

[*.properties]
charset = utf-8
